# Persomy AI - exemple de configuration. Copier vers .env puis renseigner les valeurs.
# NE JAMAIS committer le fichier .env.

# --- PostgreSQL ---
POSTGRES_DB=persomy
POSTGRES_USER=persomy
# Générer : openssl rand -hex 32   (hexadécimal : pas de caractères spéciaux dans l'URL de connexion)
POSTGRES_PASSWORD=

# --- Backend (DATABASE_URL est construit par docker-compose.yml) ---
APP_ENV=production
# Origines autorisées pour les requêtes modifiantes (contrôle Origin), séparées par des virgules
TRUSTED_ORIGINS=https://app.persomy.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
LOG_LEVEL=INFO

# --- Authentification à deux facteurs (TOTP) ---
# Clé qui chiffre les secrets TOTP en base. Vide = 2FA indisponible (aucun secret en clair n'est écrit).
# Générer : docker compose exec backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À SAUVEGARDER hors du VPS : perdue ou modifiée, les secrets existants deviennent illisibles (réinitialisation par la CLI).
TWO_FACTOR_KEY=

# --- Fournisseur IA ---
# Vide = aucun fournisseur : l'exécution des tâches répond 409 provider_not_configured.
# Aucun fournisseur réel n'est encore implémenté ; toute valeur inconnue est traitée comme "non configuré".
AI_PROVIDER=
# Délai maximal d'un appel au fournisseur (secondes)
AI_TIMEOUT_SECONDS=60

# --- Frontend ---
# URL interne du backend, utilisée par le proxy Next.js (réseau Docker)
BACKEND_INTERNAL_URL=http://backend:8000
